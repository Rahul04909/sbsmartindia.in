# --- SEO & Security Enhancements ---

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Canonicalization: Redirect WWW to Non-WWW
    # Redirection from https://www.sbsmart.in/ to https://sbsmart.in/
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# 3. HSTS Security Header
<IfModule mod_headers.c>
    # Forces browsers to only connect over HTTPS
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# 4. Custom 404 Error Handler
ErrorDocument 404 /404.php

# --- End SEO & Security Enhancements ---
